# Development only: these values match infra/compose.dev.yml, not cloud credentials.
# Export these variables in your shell; Go does not load .env files automatically.
DATABASE_URL=postgres://isaber_dev:isaber_local_only@127.0.0.1:5432/isaber?sslmode=disable
MIGRATION_DATABASE_URL=postgres://isaber_dev:isaber_local_only@127.0.0.1:5432/isaber?sslmode=disable
OWNER_DATABASE_URL=postgres://isaber_dev:isaber_local_only@127.0.0.1:5432/isaber?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
APP_ENV=development
SITE_ORIGIN=http://127.0.0.1:3000
# Development generates an ephemeral CSRF key when CSRF_SECRET is absent.
# Production requires HTTPS SITE_ORIGIN and a secret base64-encoded 32-byte key.

# Private local development staging. Run from backend/; do not serve this directory.
UPLOAD_DIR=.data/uploads

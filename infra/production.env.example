# Server-only /opt/isaber/.env, mode 0600. Never commit real values.
# Use unquoted values. Passwords: openssl rand -hex 32; CSRF: openssl rand -base64 32.
# Public DNS name or public IPv4 address; HTTPS is required for owner sign-in.
BLOG_DOMAIN=blog.example.com
# Optional DNS aliases, space-separated; all redirect to BLOG_DOMAIN.
BLOG_ALIASES=www.blog.example.com
# Bind the LAN address, leaving existing Tailscale/private listeners alone.
BLOG_BIND_ADDR=10.2.0.6
POSTGRES_PASSWORD=replace_with_64_hex_characters
RUNTIME_PASSWORD=replace_with_a_different_64_hex_password
CSRF_SECRET=replace_with_a_base64_encoded_32_byte_key

[Unit]
Description=Encrypted iSaber staging backup to Tencent
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I /opt/isaber-staging/config/offsite.py
TimeoutStartSec=45min
TimeoutStopSec=8min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

